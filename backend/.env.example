# ─── LLM PROVIDER ────────────────────────────────────────────────────────────
# "openai" (default) or "groq". Selects which client createChatModel() builds.
LLM_PROVIDER=openai

# Required when LLM_PROVIDER=openai
OPENAI_API_KEY=sk-proj-your_key_here
# gpt-5.6 (flagship) | gpt-5.6-terra (balanced) | gpt-5.6-luna (cheapest)
OPENAI_MODEL=gpt-5.6

# Required when LLM_PROVIDER=groq
GROQ_API_KEY=your_groq_api_key_here
# NOTE: "openai/gpt-oss-120b" is an open-weight model HOSTED BY GROQ.
# It authenticates with GROQ_API_KEY, not OPENAI_API_KEY.
GROQ_MODEL=openai/gpt-oss-120b

# Set to true if the model rejects an explicit `temperature` (some reasoning
# models only accept the default). Omits the param from every call.
LLM_DISABLE_TEMPERATURE=false   # auto-detected for gpt-5*/o-series; force with true

# ─── WEB SEARCH (required for Deep Research / agent mode) ────────────────────
TAVILY_API_KEY=your_tavily_api_key_here

# ─── AUTH + USAGE QUOTAS (required) ──────────────────────────────────────────
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key_here

# ─── SERVER ──────────────────────────────────────────────────────────────────
PORT=3001
